# Local account, learning progress, and saved course storage (Node >=22.13).
# Relative paths resolve from Museion/. Keep data/ on a persistent disk.
MUSEION_DATABASE_PATH=./data/museion.sqlite
MUSEION_UPLOADS_PATH=./data/uploads
# Signup codes are delivered to this private local folder. No email is sent.
MUSEION_AUTH_OUTBOX_PATH=./data/auth-outbox
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secure cookies are automatic in production. For local `npm start` over HTTP,
# set 0 locally; every HTTPS deployment must keep 1.
# MUSEION_COOKIE_SECURE=0

# The learning engine works without a paid model or provider credentials.
# Local Codex is opt-in and uses the operator's configured runtime.
MUSEION_LOCAL_AI=0
MUSEION_LIVE_AI_ENABLED=0
# MUSEION_CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex

# Optional explicit API mode. Never required for signup or local lessons.
# OPENAI_API_KEY=
# OPENAI_MODEL=your-api-model
# OPENAI_COMPILER_MODEL=your-api-model

# Public MCP stays disabled; the product API requires a Museion session.
MUSEION_MCP_PUBLIC_ENABLED=0

# Free tutor testing (explicit opt-in; no paid fallback).
# MUSEION_AI_PROVIDER=openrouter-free
# OPENROUTER_API_KEY=

# Public indexing is off until a public HTTPS origin and this switch are set.
MUSEION_PUBLIC_INDEXING=0
# Replace the clearly marked example values in the legal drafts before release.
# MUSEION_OPERATOR_NAME=
# MUSEION_OPERATOR_COUNTRY=
# MUSEION_OPERATOR_EMAIL=
