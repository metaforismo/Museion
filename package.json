{
  "name": "museion",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "db:generate": "drizzle-kit generate",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "verify:sites": "npm run build:sites && node scripts/verify-sites-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "generate:golden-source": "node scripts/generate-golden-source.mjs",
    "generate:golden-course": "node scripts/generate-golden-course.mjs",
    "redteam": "vitest run tests/redteam.live.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.6",
    "openai": "^6.47.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.2.6",
    "vinext": "^0.0.50",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.37.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.13",
    "vitest": "^4.1.8",
    "wrangler": "^4.92.0"
  },
  "description": "Interactive learning platform with deterministic ground truth and a leak-gated Socratic AI tutor.",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.19"
    }
  },
  "type": "module"
}
